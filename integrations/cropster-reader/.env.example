# Server runtime only. Never supply these as Docker build arguments.
CROPSTER_EMAIL=
CROPSTER_PASSWORD=
CROPSTER_READER_TOKEN=
# Nonsecret IDs of the two signature blend profiles and the two single groups.
CROPSTER_LIBERTY_BLEND_ID=
CROPSTER_RHYTHM_BLEND_ID=
CROPSTER_OH_GROUP_ID=
CROPSTER_DECAF_GROUP_ID=
PORT=10000
# Full captures run as asynchronous jobs; each browser job has this deadline.
CROPSTER_READER_TIMEOUT_MS=180000
# Enable only when the host supports Chromium user namespaces/seccomp.
CHROMIUM_SANDBOX=false
# Optional completion delivery. Set URL and token together, or leave both blank.
# The destination is the dashboard's fixed authenticated ingestion route.
DASHBOARD_SYNC_URL=
DASHBOARD_SYNC_TOKEN=
# Optional exact custom hostname; otherwise only a .chatgpt.site is accepted.
DASHBOARD_SYNC_HOST=
