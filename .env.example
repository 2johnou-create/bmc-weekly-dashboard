# Optional one-time approved classification of legacy profile plan/history assignments.
# JSON keyed by profile-group ID, with plannedLotIds and historicalLotIds arrays.
CROPSTER_PROFILE_ASSIGNMENTS_JSON=
# Private read-only Expenses sheet bridge (Apps Script).
GOOGLE_BRIDGE_URL=
GOOGLE_BRIDGE_TOKEN=

# Enable the pull-based Cropster worker after provisioning its dedicated token.
CROPSTER_RUNNER_ENABLED=false
CROPSTER_RUNNER_TOKEN=
