# Server-only runtime secrets. Stockroom sign-in verifies the existing app password.
SESSION_SECRET=
DISPATCH_READ_TOKEN=
DASHBOARD_DISPATCH_URL=https://bmc-dispatch-delivery.misty-jelly-1931.chatgpt.site/api/integrations/dashboard/weekly
# Optional direct-website reader. Cropster credentials belong only on the reader host.
CROPSTER_READER_URL=
CROPSTER_READER_TOKEN=
# Dedicated reader-to-dashboard write credential, separate from visitor sign-in.
